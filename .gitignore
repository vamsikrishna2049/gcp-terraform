cat > .gitignore <<'EOF'
# Terraform working files
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive local CLI configuration
.terraformrc
terraform.rc
EOF